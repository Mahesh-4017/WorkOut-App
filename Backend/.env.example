PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/workout_db
JWT_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-a-different-long-random-secret
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-app-password
EMAIL_FROM=your-email@gmail.com
# For non-Gmail SMTP, configure SMTP_HOST, SMTP_PORT, and SMTP_SECURE instead.
# Phone verification is optional and requires your own SMS provider webhook.
OTP_SMS_WEBHOOK_URL=
OTP_DELIVERY_TOKEN=
