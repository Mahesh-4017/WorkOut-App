PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/workout
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Gmail: use a Google App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
SMTP_FROM=WorkOut <your-sending-address@gmail.com>
PUBLIC_APP_URL=http://localhost:5000